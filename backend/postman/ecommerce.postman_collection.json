            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"userEmail\", \"postman.\" + Date.now() + \"@example.com\");",
                  "pm.variables.set(\"testPassword\", \"Prova-\" + Date.now() + \"-Aa\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => {",
