                  "});",
                  "pm.test(\"success és true\", () => {",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test(\"No exposa passwordHash\", () => {",
                  "  pm.expect(pm.response.text()).to.not.include(\"passwordHash\");",
                  "});",
                  "pm.environment.set(\"userId\", pm.response.json().data._id);",
                  "pm.test(\"El servidor força role=client i active=true\", () => {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.role).to.eql(\"client\");",
