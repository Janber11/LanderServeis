      "item": [
        {
          "name": "Crear categoria (correcta)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set(\"catSlug\", \"cat-pm-\" + ts);",
                  "pm.environment.set(\"catName\", \"Categoria Postman \" + ts);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response is JSON\", () => {",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test(\"success és true\", () => {",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.environment.set(\"categoryId\", pm.response.json().data._id);",
                  "pm.test(\"active és true per defecte\", () => {",
                  "  pm.expect(pm.response.json().data.active).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{catName}}\",\n  \"slug\": \"{{catSlug}}\",\n  \"description\": \"Creada des de Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
